\f0\b 06 \'96 Return and Refund Risk by Product Category (July Sales Cohort)
\f1\b0 \
*/WITH july_category_sales AS (\
   \
    SELECT\
        p.category,\
        SUM(si.quantity) AS units_sold,\
        SUM(si.line_total) AS sales_after_discounts\
    FROM sales AS s\
    JOIN stores AS st\
        ON s.store_id = st.store_id\
    JOIN sale_items AS si\
        ON s.sale_id = si.sale_id\
    JOIN products AS p\
        ON si.product_id = p.product_id\
\
    WHERE st.store_status = 'Active'\
      AND s.sale_datetime >= TIMESTAMP '2026-07-01 00:00:00'\
      AND s.sale_datetime < TIMESTAMP '2026-07-27 00:00:00'\
\
    GROUP BY p.category\
),\
\
return_details AS (\
\
    SELECT\
        p.category,\
        r.return_id,\
        r.return_quantity,\
        r.refund_amount,\
        r.return_reason,\
        r.return_date - s.sale_datetime::date AS days_to_return\
    FROM returns AS r\
    JOIN sale_items AS si\
        ON r.sale_item_id = si.sale_item_id\
    JOIN sales AS s\
        ON si.sale_id = s.sale_id\
    JOIN stores AS st\
        ON s.store_id = st.store_id\
    JOIN products AS p\
        ON si.product_id = p.product_id\
\
    WHERE r.return_status = 'Completed'\
      AND st.store_status = 'Active'\
      AND s.sale_datetime >= TIMESTAMP '2026-07-01 00:00:00'\
      AND s.sale_datetime < TIMESTAMP '2026-07-27 00:00:00'\
),\
\
category_returns AS (\
    SELECT\
        category,\
        COUNT(*) AS return_records,\
        SUM(return_quantity) AS units_returned,\
        SUM(refund_amount) AS refunds,\
        ROUND(AVG(days_to_return), 1) AS average_days_to_return\
    FROM return_details\
    GROUP BY category\
),\
\
reason_ranked AS (\
    SELECT\
        category,\
        return_reason,\
        COUNT(*) AS reason_count,\
        ROW_NUMBER() OVER (\
            PARTITION BY category\
            ORDER BY COUNT(*) DESC, return_reason ASC\
        ) AS reason_rank\
    FROM return_details\
    GROUP BY\
        category,\
        return_reason\
)\
\
SELECT\
    DENSE_RANK() OVER (\
        ORDER BY COALESCE(cr.refunds, 0) DESC\
    ) AS refund_risk_rank,\
\
    js.category,\
    js.units_sold,\
    COALESCE(cr.return_records, 0) AS return_records,\
    COALESCE(cr.units_returned, 0) AS units_returned,\
\
    ROUND(\
        100.0 * COALESCE(cr.units_returned, 0)\
        / NULLIF(js.units_sold, 0),\
