\
customer_metrics AS (\
    /* Calculate each customer's July sales-cohort value. */\
    SELECT\
        c.customer_id,\
        c.loyalty_status,\
\
        COUNT(DISTINCT s.sale_id) AS transaction_count,\
\
        SUM(COALESCE(r.refund_amount, 0)) AS refunds,\
\
        SUM(\
            si.line_total - COALESCE(r.refund_amount, 0)\
        ) AS net_sales_after_returns\
\
    FROM customers AS c\
    JOIN sales AS s\
        ON c.customer_id = s.customer_id\
    JOIN stores AS st\
        ON s.store_id = st.store_id\
    JOIN sale_items AS si\
        ON s.sale_id = si.sale_id\
    LEFT JOIN return_by_item AS r\
        ON si.sale_item_id = r.sale_item_id\
\
    WHERE st.store_status = 'Active'\
      AND s.sale_datetime >= TIMESTAMP '2026-07-01 00:00:00'\
      AND s.sale_datetime < TIMESTAMP '2026-07-27 00:00:00'\
\
    GROUP BY\
        c.customer_id,\
        c.loyalty_status\
),\
\
customer_ranked AS (\
    /* Divide purchasing customers into equal-sized value tiers. */\
    SELECT\
        *,\
        NTILE(3) OVER (\
            ORDER BY net_sales_after_returns DESC, customer_id\
        ) AS value_tertile\
    FROM customer_metrics\
    WHERE net_sales_after_returns > 0\
),\
\
segment_summary AS (\
    SELECT\
        value_tertile,\
\
        CASE\
            WHEN value_tertile = 1 THEN 'High Value'\
            WHEN value_tertile = 2 THEN 'Mid Value'\
            ELSE 'Developing Value'\
        END AS customer_value_segment,\
\
        COUNT(*) AS customer_count,\
\
        COUNT(*) FILTER (\
            WHERE loyalty_status = 'Active'\
        ) AS active_loyalty_customers,\
\
        SUM(transaction_count) AS transaction_count,\
        SUM(refunds) AS refunds,\
        SUM(net_sales_after_returns) AS net_sales_after_returns\
\
    FROM customer_ranked\
    GROUP BY value_tertile\
)\
\
SELECT\
    customer_value_segment,\
\
    customer_count,\
\
    ROUND(\
        100.0 * customer_count\
        / SUM(customer_count) OVER (),\
        1\
    ) AS customer_share_pct,\
\
    active_loyalty_customers,\
\
    transaction_count,\
\
    ROUND(refunds, 2) AS refunds,\
\
    ROUND(\
        net_sales_after_returns,\
        2\
    ) AS net_sales_after_returns,\
\
    ROUND(\
        100.0 * net_sales_after_returns\
        / NULLIF(SUM(net_sales_after_returns) OVER (), 0),\
