\f0\b\fs24 \cf0 01 \'96 Active Store Financial Performance
\f1\b0 \
*/WITH return_by_item AS (\
    /* Aggregate completed refunds and returned quantities by original sale item. */\
    SELECT\
        sale_item_id,\
        SUM(return_quantity) AS returned_quantity,\
        SUM(refund_amount) AS refund_amount\
    FROM returns\
    WHERE return_status = 'Completed'\
    GROUP BY sale_item_id\
),\
\
store_sales AS (\
    /* Analyze the July 1\'9626 sales cohort only. */\
    SELECT\
        s.store_id,\
\
        /* Original selling price before discounts and refunds. */\
        SUM(si.quantity * si.unit_price) AS gross_sales,\
\
        /* Promotion or other line-level discounts. */\
        SUM(COALESCE(si.discount_amount, 0)) AS discounts,\
\
        /* Sales after discounts but before refunds. */\
        SUM(si.line_total) AS sales_after_discounts,\
\
        /* Refunds only for returns tied to these July sale items. */\
        SUM(COALESCE(r.refund_amount, 0)) AS refunds,\
\
        /* Net sales after discounts and completed refunds. */\
        SUM(si.line_total - COALESCE(r.refund_amount, 0))\
            AS net_sales_after_returns,\
\
        /* COGS only for units ultimately retained by customers. */\
        SUM(\
            (si.quantity - COALESCE(r.returned_quantity, 0))\
            * si.unit_cost_at_sale\
        ) AS estimated_cogs\
\
    FROM sales AS s\
    JOIN sale_items AS si\
        ON s.sale_id = si.sale_id\
    LEFT JOIN return_by_item AS r\
        ON si.sale_item_id = r.sale_item_id\
\
    WHERE s.sale_datetime >= TIMESTAMP '2026-07-01 00:00:00'\
      AND s.sale_datetime < TIMESTAMP '2026-07-27 00:00:00'\
\
    GROUP BY s.store_id\
)\
\
SELECT\
    st.store_name,\
\
    ROUND(COALESCE(ss.gross_sales, 0), 2) AS gross_sales,\
    ROUND(COALESCE(ss.discounts, 0), 2) AS discounts,\
    ROUND(COALESCE(ss.sales_after_discounts, 0), 2)\
        AS sales_after_discounts,\
    ROUND(COALESCE(ss.refunds, 0), 2) AS refunds,\
    ROUND(COALESCE(ss.net_sales_after_returns, 0), 2)\
        AS net_sales_after_returns,\
    ROUND(COALESCE(ss.estimated_cogs, 0), 2)\
        AS estimated_cogs,\
\
    ROUND(\
        COALESCE(ss.net_sales_after_returns, 0)\
        - COALESCE(ss.estimated_cogs, 0),\
        2\
    ) AS estimated_gross_profit,\
\
    ROUND(\
        100.0 *\
        (\
            COALESCE(ss.net_sales_after_returns, 0)\
            - COALESCE(ss.estimated_cogs, 0)\
        )\
        / NULLIF(COALESCE(ss.net_sales_after_returns, 0), 0),\
        1\
    ) AS gross_margin_pct\
\
FROM stores AS st\
LEFT JOIN store_sales AS ss\
    ON st.store_id = ss.store_id\
\
WHERE st.store_status = 'Active'\
\
ORDER BY estimated_gross_profit DESC;/*\
